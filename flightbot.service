[Unit]
Description=Flight Price Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ЗАМЕНИТЕ путь и пользователя под свой сервер:
WorkingDirectory=/home/youruser/flightbot
ExecStart=/usr/bin/python3 /home/youruser/flightbot/bot.py
Restart=always
RestartSec=10

# Токены задаём здесь (безопаснее, чем в коде):
Environment=TP_TOKEN=ВАШ_ТОКЕН_TRAVELPAYOUTS
Environment=TG_TOKEN=ВАШ_ТОКЕН_БОТА
Environment=TG_CHAT_ID=ВАШ_CHAT_ID

[Install]
WantedBy=multi-user.target
